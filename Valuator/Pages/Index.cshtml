@page
@model IndexModel
@{
    ViewData["Title"] = "Главная";
    var port = HttpContext.Connection.LocalPort;
    Console.WriteLine($"Server port: {port}");
}

<div class="text-center">
    <form method="post">

        <div class="col-2">
            Текст для оценки:
        </div>

        <div class="col-10">
            <textarea name="text" rows="5" cols="50"></textarea>
        </div>

        <br />

        <div class="col-2">
            Страна:
        </div>

        <div class="col-5">
            <select name="country">

                <option value="Russia">
                    Russia
                </option>

                <option value="France">
                    France
                </option>

                <option value="Germany">
                    Germany
                </option>

                <option value="UAE">
                    UAE
                </option>

                <option value="India">
                    India
                </option>

            </select>
        </div>

        <br />

        <input type="submit" />

    </form>
</div>